<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="PingFlud.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:PingFlud.Core">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <NavigationView x:Name="Navigation" PaneDisplayMode="LeftCompact" IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False" OpenPaneLength="220" CompactPaneLength="52">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Scan workspace" Icon="Play" IsSelected="True" AutomationProperties.Name="Scan workspace" />
                <NavigationViewItem Content="Scan settings" Icon="Setting" AutomationProperties.Name="Scan settings"
                                    Tapped="SettingsNavigation_Tapped" />
                <NavigationViewItem Content="Documentation" Icon="Help" AutomationProperties.Name="Documentation"
                                    Tapped="DocumentationNavigation_Tapped" />
                <NavigationViewItem Content="About" Icon="Contact" AutomationProperties.Name="About Ping Flud"
                                    Tapped="AboutNavigation_Tapped" />
            </NavigationView.MenuItems>

            <Grid Padding="28,20,28,16" RowSpacing="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="300" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock x:Name="TitleText" Text="Ping Flud" Style="{StaticResource TitleTextBlockStyle}" />
                            <TextBlock x:Name="SubtitleText" Text="Fast, transparent network reachability checks" Foreground="{StaticResource MutedTextBrush}" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="Version 1.5.2  •  OffByOneHuman" VerticalAlignment="Center"
                                   Foreground="{StaticResource MutedTextBrush}" />
                    </Grid>

                    <Border Grid.Row="1" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource CardBorderBrush}"
                            BorderThickness="1" CornerRadius="12" Padding="18">
                        <Grid RowSpacing="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <TextBlock Text="New scan" Style="{StaticResource SubtitleTextBlockStyle}" />
                                <TextBlock Text="Enter a host, IP address, range, or CIDR block" HorizontalAlignment="Right"
                                           Foreground="{StaticResource MutedTextBrush}" />
                            </Grid>
                            <Grid Grid.Row="1" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Targets" VerticalAlignment="Center" FontWeight="SemiBold" />
                                <ComboBox x:Name="TargetsBox" Grid.Column="1" IsEditable="True" ItemsSource="{x:Bind TargetHistory}"
                                          Text="{x:Bind ViewModel.Targets, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          IsEnabled="{x:Bind ViewModel.CanEditTargets, Mode=OneWay}"
                                          KeyDown="TargetsBox_KeyDown" AutomationProperties.Name="Targets" />
                                <Button Grid.Column="2" Content="Start scan" Click="StartButton_Click"
                                        IsEnabled="{x:Bind ViewModel.CanStart, Mode=OneWay}" AutomationProperties.Name="Start scan" />
                                <Button Grid.Column="3" Content="Stop" Click="StopButton_Click"
                                        IsEnabled="{x:Bind ViewModel.CanStop, Mode=OneWay}" AutomationProperties.Name="Stop scan" />
                            </Grid>
                            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                                <Button Content="Import list…" Click="ImportButton_Click" AutomationProperties.Name="Import target list" />
                                <Button Content="Scan settings" Click="SettingsButton_Click" AutomationProperties.Name="Scan settings" />
                                <Button Content="Syntax help" Click="SyntaxHelpButton_Click" AutomationProperties.Name="Target syntax help" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="FilterBox" Width="160" SelectedIndex="0" SelectionChanged="FilterBox_SelectionChanged"
                                  AutomationProperties.Name="Result filter">
                            <ComboBoxItem Content="All results" />
                            <ComboBoxItem Content="Responding" />
                            <ComboBoxItem Content="Not responding" />
                        </ComboBox>
                        <TextBox x:Name="SearchBox" Grid.Column="1" PlaceholderText="Search results" TextChanged="SearchBox_TextChanged"
                                 AutomationProperties.Name="Search results" />
                        <Button Grid.Column="3" Content="Copy" Click="CopyButton_Click"
                                IsEnabled="{x:Bind ViewModel.HasResults, Mode=OneWay}" />
                        <Button Grid.Column="4" Content="Clear" Click="ClearButton_Click"
                                IsEnabled="{x:Bind ViewModel.HasResults, Mode=OneWay}" />
                        <Button Grid.Column="5" Content="Export…" Click="ExportButton_Click"
                                IsEnabled="{x:Bind ViewModel.CanExport, Mode=OneWay}"
                                AutomationProperties.Name="Export results" />
                    </Grid>

                    <Border Grid.Row="3" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource CardBorderBrush}"
                            BorderThickness="1" CornerRadius="12">
                        <Grid>
                            <Grid RowSpacing="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="42" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid Padding="14,0" Background="#171717" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="75" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="State" Tag="Status" Tapped="ResultHeader_Tapped" VerticalAlignment="Center" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="Target" Tag="Target" Tapped="ResultHeader_Tapped" VerticalAlignment="Center" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="2" Text="Up" Tag="Responding" Tapped="ResultHeader_Tapped" VerticalAlignment="Center" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="3" Text="Latency" Tag="RoundtripMs" Tapped="ResultHeader_Tapped" VerticalAlignment="Center" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="4" Text="Loss %" Tag="PacketLossPercent" Tapped="ResultHeader_Tapped" VerticalAlignment="Center" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="5" Text="Replies" Tag="Successes" Tapped="ResultHeader_Tapped" VerticalAlignment="Center" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="6" Text="TTL" Tag="ReplyTtl" Tapped="ResultHeader_Tapped" VerticalAlignment="Center" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="7" Text="IP address" Tag="Address" Tapped="ResultHeader_Tapped" VerticalAlignment="Center" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="8" Text="Reverse DNS" Tag="HostName" Tapped="ResultHeader_Tapped" VerticalAlignment="Center" FontWeight="SemiBold" />
                                </Grid>
                                <ListView x:Name="ResultsList" Grid.Row="1" ItemsSource="{x:Bind ViewModel.Results}" SelectionMode="Multiple"
                                          AutomationProperties.Name="Scan results">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="core:ScanResult">
                                            <Grid MinHeight="38" Padding="10,0" ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="130" />
                                                    <ColumnDefinition Width="180" />
                                                    <ColumnDefinition Width="60" />
                                                    <ColumnDefinition Width="80" />
                                                    <ColumnDefinition Width="75" />
                                                    <ColumnDefinition Width="70" />
                                                    <ColumnDefinition Width="60" />
                                                    <ColumnDefinition Width="170" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{x:Bind Status}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind Target}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="2" Text="{x:Bind Responding}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="3" Text="{x:Bind RoundtripMs}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="4" Text="{x:Bind PacketLossPercent}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="5" Text="{x:Bind Successes}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="6" Text="{x:Bind ReplyTtl}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="7" Text="{x:Bind Address}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="8" Text="{x:Bind HostName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                            <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                                <FontIcon Glyph="&#xE9D9;" FontSize="36" Foreground="{StaticResource MutedTextBrush}" />
                                <TextBlock Text="No scan results yet" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
                                <TextBlock Text="Enter a host, IP address, range, or CIDR above to begin."
                                           Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="4" ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="180" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.Summary, Mode=OneWay}" VerticalAlignment="Center"
                                   Foreground="{StaticResource MutedTextBrush}" />
                        <ProgressBar Grid.Column="2" Minimum="0" Maximum="100" Value="{x:Bind ViewModel.ProgressPercent, Mode=OneWay}" />
                    </Grid>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
