<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="PingFlud.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:PingFlud.Core"
    xmlns:local="using:PingFlud.WinUI">

    <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.Resources>
            <local:RespondingBrushConverter x:Key="RespondingBrushConverter" />
        </Grid.Resources>
        <NavigationView x:Name="Navigation" PaneDisplayMode="LeftCompact" IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False" OpenPaneLength="220" CompactPaneLength="52"
                        SelectionChanged="Navigation_SelectionChanged">
            <NavigationView.Resources>
                <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="{ThemeResource AccentColor}" />
                <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="{ThemeResource SelectionColor}" />
                <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="{ThemeResource SelectionColor}" />
            </NavigationView.Resources>
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Scan workspace" Icon="Play" Tag="Workspace" IsSelected="True" AutomationProperties.Name="Scan workspace" />
                <NavigationViewItem Content="Scan settings" Icon="Setting" Tag="Settings" AutomationProperties.Name="Scan settings" />
                <NavigationViewItem Content="Documentation" Icon="Help" Tag="Documentation" AutomationProperties.Name="Documentation" />
                <NavigationViewItem Content="About" Icon="Contact" Tag="About" AutomationProperties.Name="About Ping Flud" />
            </NavigationView.MenuItems>

            <Grid Padding="28,20,28,16" RowSpacing="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="300" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock x:Name="TitleText" Text="Ping Flud" Style="{StaticResource TitleTextBlockStyle}" />
                            <TextBlock x:Name="SubtitleText" Text="Network reachability testing and troubleshooting" Foreground="{ThemeResource MutedTextBrush}" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="Version 1.5.4  •  OffByOneHuman" VerticalAlignment="Center"
                                   Foreground="{ThemeResource MutedTextBrush}" />
                        <ToggleButton x:Name="ThemeToggleButton" Grid.Column="2" Width="40" Height="40" MinWidth="40" MinHeight="40" Padding="0"
                                      Background="{ThemeResource AccentBrush}" Foreground="{ThemeResource AccentForegroundBrush}"
                                      BorderBrush="{ThemeResource AccentBrush}"
                                      HorizontalAlignment="Right" Checked="ThemeToggleButton_Checked"
                                      Unchecked="ThemeToggleButton_Unchecked"
                                      AutomationProperties.Name="Appearance mode"
                                      AutomationProperties.HelpText="Sun icon means Light mode; moon icon means Dark mode. Activate to switch."
                                      ToolTipService.ToolTip="Switch between Light and Dark modes">
                            <FontIcon x:Name="ThemeIcon" FontFamily="Segoe MDL2 Assets" Glyph="&#xE708;" FontSize="20"
                                      Foreground="{ThemeResource AccentForegroundBrush}" />
                        </ToggleButton>
                    </Grid>

                    <Border Grid.Row="1" Background="{ThemeResource CardBackgroundBrush}" BorderBrush="{ThemeResource CardBorderBrush}"
                            BorderThickness="1" CornerRadius="12" Padding="18">
                        <Grid RowSpacing="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <TextBlock Text="New scan" Style="{StaticResource SubtitleTextBlockStyle}" />
                                <TextBlock Text="Test hosts, IPs, ranges, or CIDR blocks" HorizontalAlignment="Right"
                                           Foreground="{ThemeResource MutedTextBrush}" />
                            </Grid>
                            <Grid Grid.Row="1" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Targets" VerticalAlignment="Center" FontWeight="SemiBold" />
                                <ComboBox x:Name="TargetsBox" Grid.Column="1" Width="520" MinWidth="420" MinHeight="40"
                                          HorizontalAlignment="Left" VerticalAlignment="Center" IsEditable="True"
                                          PlaceholderText="Host, IP, range, or CIDR block" ItemsSource="{x:Bind TargetHistory}"
                                          Text="{x:Bind ViewModel.Targets, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          IsEnabled="{x:Bind ViewModel.CanEditTargets, Mode=OneWay}"
                                          AutomationProperties.Name="Targets" />
                                <Button Grid.Column="2" Content="Start scan" Click="StartButton_Click"
                                        IsEnabled="{x:Bind ViewModel.CanStart, Mode=OneWay}" AutomationProperties.Name="Start scan" />
                                <Button Grid.Column="3" Content="Stop" Click="StopButton_Click"
                                        IsEnabled="{x:Bind ViewModel.CanStop, Mode=OneWay}" AutomationProperties.Name="Stop scan" />
                            </Grid>
                            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                                <Button Content="Import list…" Click="ImportButton_Click" AutomationProperties.Name="Import target list" />
                                <Button Content="Scan settings" Click="SettingsButton_Click" AutomationProperties.Name="Scan settings" />
                                <Button Content="Syntax help" Click="SyntaxHelpButton_Click" AutomationProperties.Name="Target syntax help" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="FilterBox" Width="160" SelectedIndex="0" SelectionChanged="FilterBox_SelectionChanged"
                                  AutomationProperties.Name="Result filter">
                            <ComboBoxItem Content="All results" />
                            <ComboBoxItem Content="Responding" />
                            <ComboBoxItem Content="Not responding" />
                        </ComboBox>
                        <TextBox x:Name="SearchBox" Grid.Column="1" PlaceholderText="Search results" TextChanged="SearchBox_TextChanged"
                                 AutomationProperties.Name="Search results" />
                        <Button Grid.Column="3" Content="Copy" Click="CopyButton_Click"
                                IsEnabled="{x:Bind ViewModel.CanCopyResults, Mode=OneWay}"
                                ToolTipService.ToolTip="Copy selected rows, or all visible rows when none are selected"
                                AutomationProperties.Name="Copy visible results" />
                        <Button Grid.Column="4" Content="Clear" Click="ClearButton_Click"
                                IsEnabled="{x:Bind ViewModel.CanClearResults, Mode=OneWay}"
                                AutomationProperties.Name="Clear results" />
                        <Button Grid.Column="5" Content="Export…" Click="ExportButton_Click"
                                IsEnabled="{x:Bind ViewModel.CanExport, Mode=OneWay}"
                                ToolTipService.ToolTip="Export the visible filtered and sorted results"
                                AutomationProperties.Name="Export results" />
                    </Grid>

                    <Border Grid.Row="3" Background="{ThemeResource CardBackgroundBrush}" BorderBrush="{ThemeResource CardBorderBrush}"
                            BorderThickness="1" CornerRadius="12">
                        <Grid>
                            <Grid RowSpacing="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="42" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid Padding="42,0,14,0" Background="{ThemeResource ResultsHeaderBackgroundBrush}" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="75" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="State" Tag="Status" Tapped="ResultHeader_Tapped" HorizontalAlignment="Stretch" TextAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" />
                                    <TextBlock Grid.Column="1" Text="Target" Tag="Target" Tapped="ResultHeader_Tapped" HorizontalAlignment="Stretch" TextAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" />
                                    <TextBlock Grid.Column="2" Text="Up" Tag="Responding" Tapped="ResultHeader_Tapped" HorizontalAlignment="Stretch" TextAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" />
                                    <TextBlock Grid.Column="3" Text="Latency" Tag="RoundtripMs" Tapped="ResultHeader_Tapped" HorizontalAlignment="Stretch" TextAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" />
                                    <TextBlock Grid.Column="4" Text="Loss %" Tag="PacketLossPercent" Tapped="ResultHeader_Tapped" HorizontalAlignment="Stretch" TextAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" />
                                    <TextBlock Grid.Column="5" Text="Replies" Tag="Successes" Tapped="ResultHeader_Tapped" HorizontalAlignment="Stretch" TextAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" />
                                    <TextBlock Grid.Column="6" Text="TTL" Tag="ReplyTtl" Tapped="ResultHeader_Tapped" HorizontalAlignment="Stretch" TextAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" />
                                    <TextBlock Grid.Column="7" Text="IP address" Tag="Address" Tapped="ResultHeader_Tapped" HorizontalAlignment="Stretch" TextAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" />
                                    <TextBlock Grid.Column="8" Text="Reverse DNS" Tag="HostName" Tapped="ResultHeader_Tapped" HorizontalAlignment="Stretch" TextAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" />
                                </Grid>
                                <ListView x:Name="ResultsList" Grid.Row="1" ItemsSource="{x:Bind ViewModel.Results}" SelectionMode="Multiple"
                                          IsMultiSelectCheckBoxEnabled="False"
                                          SelectionChanged="ResultsList_SelectionChanged"
                                          Padding="0" AutomationProperties.Name="Scan results">
                                    <ListView.Resources>
                                        <SolidColorBrush x:Key="ListViewItemCheckBoxBrush" Color="{ThemeResource GraphiteRaisedColor}" />
                                        <SolidColorBrush x:Key="ListViewItemCheckBoxPointerOverBrush" Color="{ThemeResource GraphiteRaisedColor}" />
                                        <SolidColorBrush x:Key="ListViewItemCheckBoxPressedBrush" Color="{ThemeResource GraphiteRaisedColor}" />
                                        <SolidColorBrush x:Key="ListViewItemCheckBoxSelectedBrush" Color="{ThemeResource AccentColor}" />
                                        <SolidColorBrush x:Key="ListViewItemCheckBoxSelectedPointerOverBrush" Color="{ThemeResource AccentColor}" />
                                        <SolidColorBrush x:Key="ListViewItemCheckBoxSelectedPressedBrush" Color="{ThemeResource AccentColor}" />
                                        <SolidColorBrush x:Key="ListViewItemCheckBoxBorderBrush" Color="{ThemeResource GraphiteMutedColor}" />
                                        <SolidColorBrush x:Key="ListViewItemCheckBoxPointerOverBorderBrush" Color="{ThemeResource GraphiteMutedColor}" />
                                        <SolidColorBrush x:Key="ListViewItemCheckBoxPressedBorderBrush" Color="{ThemeResource GraphiteMutedColor}" />
                                        <SolidColorBrush x:Key="ListViewItemCheckBoxSelectedDisabledBrush" Color="{ThemeResource GraphiteMutedColor}" />
                                        <SolidColorBrush x:Key="ListViewItemCheckBrush" Color="{ThemeResource AccentForegroundColor}" />
                                        <SolidColorBrush x:Key="ListViewItemCheckPressedBrush" Color="{ThemeResource AccentForegroundColor}" />
                                        <SolidColorBrush x:Key="ListViewItemCheckHintThemeBrush" Color="{ThemeResource AccentForegroundColor}" />
                                        <SolidColorBrush x:Key="ListViewItemCheckSelectingThemeBrush" Color="{ThemeResource AccentForegroundColor}" />
                                        <SolidColorBrush x:Key="ListViewItemCheckThemeBrush" Color="{ThemeResource AccentForegroundColor}" />
                                        <SolidColorBrush x:Key="ListViewItemSelectionIndicatorBrush" Color="{ThemeResource AccentColor}" />
                                        <SolidColorBrush x:Key="ListViewItemSelectionIndicatorPointerOverBrush" Color="{ThemeResource AccentColor}" />
                                        <SolidColorBrush x:Key="ListViewItemSelectionIndicatorPressedBrush" Color="{ThemeResource AccentColor}" />
                                        <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="{ThemeResource SelectionColor}" />
                                        <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="{ThemeResource SelectionColor}" />
                                        <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="{ThemeResource SelectionColor}" />
                                        <x:Boolean x:Key="ListViewItemSelectionCheckMarkVisualEnabled">False</x:Boolean>
                                        <Style x:Key="ResultSelectionCheckBoxStyle" TargetType="CheckBox">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="CheckBox">
                                                        <Grid Width="24" Height="24">
                                                            <Border x:Name="Box" CornerRadius="4" BorderThickness="2"
                                                                    Background="{ThemeResource ResultCheckboxUncheckedBrush}"
                                                                    BorderBrush="{ThemeResource ResultCheckboxUncheckedBorderBrush}" />
                                                            <FontIcon x:Name="CheckMark" Glyph="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                                                      Foreground="{ThemeResource ResultCheckboxCheckMarkBrush}"
                                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                      Visibility="Collapsed" />
                                                            <Border x:Name="FocusRing" CornerRadius="3" BorderThickness="1"
                                                                    BorderBrush="{ThemeResource AccentBrush}" Margin="2"
                                                                    Opacity="0" />
                                                            <VisualStateManager.VisualStateGroups>
                                                                <VisualStateGroup x:Name="CheckStates">
                                                                    <VisualState x:Name="Unchecked" />
                                                                    <VisualState x:Name="Checked">
                                                                        <Storyboard>
                                                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Box" Storyboard.TargetProperty="Background">
                                                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ResultCheckboxCheckedBrush}" />
                                                                            </ObjectAnimationUsingKeyFrames>
                                                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Box" Storyboard.TargetProperty="BorderBrush">
                                                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ResultCheckboxCheckedBorderBrush}" />
                                                                            </ObjectAnimationUsingKeyFrames>
                                                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CheckMark" Storyboard.TargetProperty="Visibility">
                                                                                <DiscreteObjectKeyFrame KeyTime="0" Value="Visible" />
                                                                            </ObjectAnimationUsingKeyFrames>
                                                                        </Storyboard>
                                                                    </VisualState>
                                                                    <VisualState x:Name="Indeterminate">
                                                                        <Storyboard>
                                                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Box" Storyboard.TargetProperty="Background">
                                                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ResultCheckboxCheckedBrush}" />
                                                                            </ObjectAnimationUsingKeyFrames>
                                                                        </Storyboard>
                                                                    </VisualState>
                                                                </VisualStateGroup>
                                                                <VisualStateGroup x:Name="CommonStates">
                                                                    <VisualState x:Name="Normal" />
                                                                    <VisualState x:Name="PointerOver">
                                                                        <Storyboard>
                                                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Box" Storyboard.TargetProperty="BorderBrush">
                                                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource AccentBrush}" />
                                                                            </ObjectAnimationUsingKeyFrames>
                                                                        </Storyboard>
                                                                    </VisualState>
                                                                    <VisualState x:Name="Pressed">
                                                                        <Storyboard>
                                                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Box" Storyboard.TargetProperty="BorderBrush">
                                                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource AccentBrush}" />
                                                                            </ObjectAnimationUsingKeyFrames>
                                                                        </Storyboard>
                                                                    </VisualState>
                                                                </VisualStateGroup>
                                                                <VisualStateGroup x:Name="FocusStates">
                                                                    <VisualState x:Name="Unfocused" />
                                                                    <VisualState x:Name="Focused">
                                                                        <Storyboard>
                                                                            <DoubleAnimation Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                                                        </Storyboard>
                                                                    </VisualState>
                                                                </VisualStateGroup>
                                                            </VisualStateManager.VisualStateGroups>
                                                        </Grid>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="Margin" Value="0" />
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="VerticalContentAlignment" Value="Center" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListViewItem">
                                                        <ListViewItemPresenter x:Name="Root"
                                                            ContentTransitions="{TemplateBinding ContentTransitions}"
                                                            Control.IsTemplateFocusTarget="True"
                                                            FocusVisualMargin="{TemplateBinding FocusVisualMargin}"
                                                            SelectionCheckMarkVisualEnabled="False"
                                                            CheckBrush="{ThemeResource ListViewItemCheckBrush}"
                                                            CheckBoxBrush="{ThemeResource ListViewItemCheckBoxBrush}"
                                                            DragBackground="{ThemeResource ListViewItemDragBackground}"
                                                            DragForeground="{ThemeResource ListViewItemDragForeground}"
                                                            FocusBorderBrush="{ThemeResource ListViewItemFocusBorderBrush}"
                                                            FocusSecondaryBorderBrush="{ThemeResource ListViewItemFocusSecondaryBorderBrush}"
                                                            PlaceholderBackground="{ThemeResource ListViewItemPlaceholderBackground}"
                                                            PointerOverBackground="{ThemeResource ListViewItemBackgroundPointerOver}"
                                                            PointerOverForeground="{ThemeResource ListViewItemForegroundPointerOver}"
                                                            SelectedBackground="{ThemeResource ListViewItemBackgroundSelected}"
                                                            SelectedForeground="{ThemeResource ListViewItemForegroundSelected}"
                                                            SelectedPointerOverBackground="{ThemeResource ListViewItemBackgroundSelectedPointerOver}"
                                                            PressedBackground="{ThemeResource ListViewItemBackgroundPressed}"
                                                            SelectedPressedBackground="{ThemeResource ListViewItemBackgroundSelectedPressed}"
                                                            DisabledOpacity="{ThemeResource ListViewItemDisabledThemeOpacity}"
                                                            DragOpacity="{ThemeResource ListViewItemDragThemeOpacity}"
                                                            ReorderHintOffset="{ThemeResource ListViewItemReorderHintThemeOffset}"
                                                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                                            ContentMargin="{TemplateBinding Padding}"
                                                            CheckMode="{ThemeResource ListViewItemCheckMode}" />
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListView.Resources>
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="core:ScanResult">
                                            <Grid MinHeight="38">
                                                <Grid Padding="42,0,14,0" ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="130" />
                                                    <ColumnDefinition Width="180" />
                                                    <ColumnDefinition Width="60" />
                                                    <ColumnDefinition Width="80" />
                                                    <ColumnDefinition Width="75" />
                                                    <ColumnDefinition Width="70" />
                                                    <ColumnDefinition Width="60" />
                                                    <ColumnDefinition Width="170" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{x:Bind Status}" HorizontalAlignment="Stretch" TextAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind Target}" HorizontalAlignment="Stretch" TextAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="2" Text="{x:Bind Responding}" HorizontalAlignment="Stretch" TextAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"
                                                           Foreground="{Binding Responding, Converter={StaticResource RespondingBrushConverter}}" />
                                                <TextBlock Grid.Column="3" Text="{x:Bind RoundtripMs}" HorizontalAlignment="Stretch" TextAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" />
                                                <TextBlock Grid.Column="4" Text="{x:Bind PacketLossPercent}" HorizontalAlignment="Stretch" TextAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" />
                                                <TextBlock Grid.Column="5" Text="{x:Bind Successes}" HorizontalAlignment="Stretch" TextAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" />
                                                <TextBlock Grid.Column="6" Text="{x:Bind ReplyTtl}" HorizontalAlignment="Stretch" TextAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" />
                                                <TextBlock Grid.Column="7" Text="{x:Bind Address}" HorizontalAlignment="Stretch" TextAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="8" Text="{x:Bind HostName}" HorizontalAlignment="Stretch" TextAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                                </Grid>
                                                <CheckBox Width="24" Height="24" MinWidth="24" MinHeight="24" Margin="4,0,0,0" Padding="0"
                                                          HorizontalAlignment="Left" HorizontalContentAlignment="Center" VerticalAlignment="Center"
                                                          Style="{StaticResource ResultSelectionCheckBoxStyle}"
                                                          Loaded="ResultSelectionCheckBox_Loaded"
                                                          Checked="ResultSelectionCheckBox_Checked"
                                                          Unchecked="ResultSelectionCheckBox_Unchecked"
                                                          AutomationProperties.Name="Select result" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                            <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                                <FontIcon Glyph="&#xE9D9;" FontSize="36" Foreground="{ThemeResource MutedTextBrush}" />
                                <TextBlock Text="No reachability results yet" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
                                <TextBlock Text="Enter targets above to test latency, packet loss, TTL, and reverse DNS."
                                           Foreground="{ThemeResource MutedTextBrush}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="4" ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="180" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.Summary, Mode=OneWay}" VerticalAlignment="Center"
                                   Foreground="{ThemeResource MutedTextBrush}" />
                        <ProgressBar Grid.Column="2" Foreground="{ThemeResource ProgressBrush}" Minimum="0" Maximum="100" Value="{x:Bind ViewModel.ProgressPercent, Mode=OneWay}" />
                    </Grid>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
