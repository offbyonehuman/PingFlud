<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="PingFlud.WinUI.SettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Scan settings"
    PrimaryButtonText="Save settings"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    PrimaryButtonClick="ContentDialog_PrimaryButtonClick">

    <ScrollViewer MaxHeight="680" VerticalScrollBarVisibility="Auto">
        <StackPanel Width="620" Spacing="14">
            <TextBlock Text="Tune ICMP behavior, safety limits, appearance, and window labels."
                       Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
            <InfoBar x:Name="ValidationError" Severity="Error" IsOpen="False" IsClosable="False" />

            <TextBlock Text="Probe behavior" Style="{StaticResource SubtitleTextBlockStyle}" />
            <Grid ColumnSpacing="18" RowSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="220" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Max outstanding packets" VerticalAlignment="Center" />
                <NumberBox x:Name="MaxOutstandingBox" Grid.Column="1" Minimum="1" Maximum="1024" SpinButtonPlacementMode="Compact" />
                <TextBlock Grid.Row="1" Text="Timeout (milliseconds)" VerticalAlignment="Center" />
                <NumberBox x:Name="TimeoutBox" Grid.Row="1" Grid.Column="1" Minimum="1" Maximum="120000" SpinButtonPlacementMode="Compact" />
                <TextBlock Grid.Row="2" Text="Pings per target" VerticalAlignment="Center" />
                <NumberBox x:Name="PingsBox" Grid.Row="2" Grid.Column="1" Minimum="1" Maximum="10" SpinButtonPlacementMode="Compact" />
                <TextBlock Grid.Row="3" Text="Packet TTL" VerticalAlignment="Center" />
                <NumberBox x:Name="TtlBox" Grid.Row="3" Grid.Column="1" Minimum="1" Maximum="255" SpinButtonPlacementMode="Compact" />
                <TextBlock Grid.Row="4" Text="Delay between pings (ms)" VerticalAlignment="Center" />
                <NumberBox x:Name="DelayBox" Grid.Row="4" Grid.Column="1" Minimum="0" Maximum="60000" SpinButtonPlacementMode="Compact" />
                <TextBlock Grid.Row="5" Text="Expansion safety cap" VerticalAlignment="Center" />
                <NumberBox x:Name="ExpansionBox" Grid.Row="5" Grid.Column="1" Minimum="1" Maximum="1000000" SpinButtonPlacementMode="Compact" />
                <TextBlock Grid.Row="6" Text="DNS timeout (ms)" VerticalAlignment="Center" />
                <NumberBox x:Name="DnsTimeoutBox" Grid.Row="6" Grid.Column="1" Minimum="1" Maximum="30000" SpinButtonPlacementMode="Compact" />
            </Grid>

            <TextBlock Text="ICMP payload" />
            <TextBox x:Name="PayloadBox" MaxLength="60000" AcceptsReturn="True" MinHeight="72" TextWrapping="Wrap"
                     AutomationProperties.HelpText="UTF-8 text, up to 60 KB" />
            <CheckBox x:Name="DontFragmentBox" Content="Don't Fragment (MTU testing)" />
            <CheckBox x:Name="ResolveRespondingOnlyBox" Content="Reverse DNS for responding hosts only" />

            <TextBlock Text="Appearance and labels" Style="{StaticResource SubtitleTextBlockStyle}" />
            <Grid ColumnSpacing="18" RowSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="360" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Theme" VerticalAlignment="Center" />
                <ComboBox x:Name="ThemeBox" Grid.Column="1" />
                <TextBlock Grid.Row="1" Text="Window title" VerticalAlignment="Center" />
                <TextBox x:Name="TitleBox" Grid.Row="1" Grid.Column="1" MaxLength="120" />
                <TextBlock Grid.Row="2" Text="Subtitle" VerticalAlignment="Center" />
                <TextBox x:Name="SubtitleBox" Grid.Row="2" Grid.Column="1" MaxLength="240" />
            </Grid>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
