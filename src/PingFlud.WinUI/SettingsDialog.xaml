<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="PingFlud.WinUI.SettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Scan settings"
    PrimaryButtonText="Save settings"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    PrimaryButtonClick="ContentDialog_PrimaryButtonClick">

    <ScrollViewer MaxHeight="680" VerticalScrollBarVisibility="Auto">
        <StackPanel Width="460" Spacing="14">
            <TextBlock Text="Tune ICMP probes, DNS diagnostics, safety limits, and MTU testing."
                       Foreground="{ThemeResource MutedTextBrush}" TextWrapping="Wrap" />
            <InfoBar x:Name="ValidationError" Severity="Error" IsOpen="False" IsClosable="False" />

            <TextBlock Text="Probe behavior" Style="{StaticResource SubtitleTextBlockStyle}" />
            <Grid ColumnSpacing="18" RowSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="135" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Max outstanding packets" VerticalAlignment="Center" />
                <NumberBox x:Name="MaxOutstandingBox" Grid.Column="1" Width="135" Minimum="1" Maximum="1024" SpinButtonPlacementMode="Hidden" />
                <TextBlock Grid.Row="1" Text="Timeout (milliseconds)" VerticalAlignment="Center" />
                <NumberBox x:Name="TimeoutBox" Grid.Row="1" Grid.Column="1" Width="135" Minimum="1" Maximum="120000" SpinButtonPlacementMode="Hidden" />
                <TextBlock Grid.Row="2" Text="Pings per target" VerticalAlignment="Center" />
                <NumberBox x:Name="PingsBox" Grid.Row="2" Grid.Column="1" Width="135" Minimum="1" Maximum="10" SpinButtonPlacementMode="Hidden" />
                <TextBlock Grid.Row="3" Text="Packet TTL" VerticalAlignment="Center" />
                <NumberBox x:Name="TtlBox" Grid.Row="3" Grid.Column="1" Width="135" Minimum="1" Maximum="255" SpinButtonPlacementMode="Hidden" />
                <TextBlock Grid.Row="4" Text="Delay between pings (ms)" VerticalAlignment="Center" />
                <NumberBox x:Name="DelayBox" Grid.Row="4" Grid.Column="1" Width="135" Minimum="0" Maximum="60000" SpinButtonPlacementMode="Hidden" />
                <TextBlock Grid.Row="5" Text="Expansion safety cap" VerticalAlignment="Center" />
                <NumberBox x:Name="ExpansionBox" Grid.Row="5" Grid.Column="1" Width="135" Minimum="1" Maximum="1000000" SpinButtonPlacementMode="Hidden" />
                <TextBlock Grid.Row="6" Text="DNS timeout (ms)" VerticalAlignment="Center" />
                <NumberBox x:Name="DnsTimeoutBox" Grid.Row="6" Grid.Column="1" Width="135" Minimum="1" Maximum="30000" SpinButtonPlacementMode="Hidden" />
            </Grid>

            <TextBlock Text="ICMP payload" />
            <TextBox x:Name="PayloadBox" Width="345" HorizontalAlignment="Left" MaxLength="60000" AcceptsReturn="True" MinHeight="72" TextWrapping="Wrap"
                     AutomationProperties.HelpText="UTF-8 text, up to 60 KB" />
            <CheckBox x:Name="DontFragmentBox" Content="Don't Fragment (MTU testing)" />
            <CheckBox x:Name="ResolveRespondingOnlyBox" Content="Reverse DNS for responding hosts only" />

        </StackPanel>
    </ScrollViewer>
</ContentDialog>
